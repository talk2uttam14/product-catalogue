# Copy to .env for local development. Values below are non-secret defaults.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Comma-separated allowed browser origins. Empty means no cross-origin browser access.
CORS_ORIGINS=http://localhost:5173
# Maximum accepted JSON request body size.
JSON_BODY_LIMIT=100kb
# Product catalogue settings.
FAKE_STORE_BASE_URL=https://fakestoreapi.com
PRODUCT_CACHE_TTL_MS=60000
UPSTREAM_TIMEOUT_MS=5000
# Local Mailpit SMTP defaults. Mailpit accepts unauthenticated SMTP on port 1025.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=catalogue@example.local
ENQUIRY_RECIPIENT=enquiries@example.local
